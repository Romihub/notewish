interface TemplateProps {
  // Basic info
  cardId: string;
  title: string;
  occasion: string;
  recipientName: string;
  
  // Generated content (all optional)
  message?: string;        // From MessageGenerator
  imageUrl?: string;       // From ImageGenerator
  voiceUrl?: string;       // From VoiceGenerator
  musicUrl?: string;       // From MusicGenerator
  videoUrl?: string;       // From VideoGenerator
}



export function ModernBirthdayTemplate(props: TemplateProps) {
  return (
    <div className="card-container">
      {/* Background */}
      <div className="bg-gradient-to-br from-purple-400 to-pink-400">
        
        {/* Generated Image */}
        {props.imageUrl && (
          <img src={props.imageUrl} className="hero-image" />
        )}
        
        {/* Generated Message */}
        <h1>{props.message}</h1>
        
        {/* Voice Player */}
        {props.voiceUrl && (
          <AudioPlayer src={props.voiceUrl} />
        )}
        
        {/* Background Music */}
        {props.musicUrl && (
          <BackgroundMusic src={props.musicUrl} autoPlay />
        )}
        
        {/* Video Background */}
        {props.videoUrl && (
          <video src={props.videoUrl} autoPlay muted loop />
        )}
      </div>
    </div>
  );
}
