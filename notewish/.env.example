# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-side only)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# AI Service API Keys - Text Generation
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here        # Gemini Pro/Ultra (Google AI Studio)
GOOGLE_VERTEX_PROJECT_ID=your_gcp_project_id          # For Vertex AI (Gemini on GCP)

# AI Service API Keys - Image Generation
OPENAI_DALLE_API_KEY=sk-your_openai_key_here
STABILITY_API_KEY=your_stability_ai_key_here       # Stable Diffusion
REPLICATE_API_KEY=your_replicate_key_here          # Open source models

# AI Service API Keys - Voice/Audio
ELEVENLABS_API_KEY=your_elevenlabs_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here        # Alternative TTS
GOOGLE_CLOUD_TTS_KEY=your_google_tts_key_here      # Alternative TTS

# AI Service API Keys - Music
SUNO_API_KEY=your_suno_key_here
MUBERT_API_KEY=your_mubert_key_here                # Alternative music gen

# AI Service API Keys - Video Generation
RUNWAY_API_KEY=your_runway_key_here
OPENAI_SORA_API_KEY=your_sora_key_here             # When available
PIKA_API_KEY=your_pika_key_here
GOOGLE_VEO_API_KEY=your_veo_key_here               # Google Veo 3

# Open Source / Self-Hosted Options
HUGGINGFACE_API_KEY=your_huggingface_key_here      # Access to open models
REPLICATE_API_TOKEN=your_replicate_token_here      # SDXL, MusicGen, etc.
TOGETHER_AI_API_KEY=your_together_ai_key_here      # Open source LLMs

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Credits & Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
